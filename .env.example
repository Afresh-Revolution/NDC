# =============================================================================
# NDC Naija — environment variables
# Copy to .env for development. Never commit secrets. Do not use .env.local.
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="NDC Naija"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
APP_ENV=development

# --- PostgreSQL ---
# pglite = embedded Postgres (no Docker). postgres = Docker/Supabase/managed.
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=./.pglite-data
DATABASE_URL=postgres://ndc:ndc_local_dev@localhost:5432/ndc_naija
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ndc
POSTGRES_PASSWORD=ndc_local_dev
POSTGRES_DB=ndc_naija
POSTGRES_SSL=false

# --- Session / crypto ---
AUTH_SECRET=replace-with-64-char-hex
ENCRYPTION_KEY=replace-with-64-char-hex
CRON_SECRET=replace-with-32-char-hex

# --- Super admin bootstrap (seed only) ---
SUPER_ADMIN_EMAIL=admin@ndcnaija.org
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_2026!
SUPER_ADMIN_NAME="NDC Super Admin"

# --- Feature gates (legal launch gates from the master roadmap) ---
FEATURE_LOANS_ENABLED=false
FEATURE_INVESTMENT_ENABLED=false
FEATURE_DISBURSEMENT_ENABLED=false
FEATURE_PUBLIC_EQUITY_PORTAL=false

# --- Payments: Paystack (primary NGN) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Payments: Flutterwave (optional fallback) ---
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="NDC Naija <noreply@ndcnaija.org>"

# --- Storage (Supabase Storage or local disk) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ndc-private

# --- Cloudinary (public developer / project media only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- GitHub / GitLab OAuth (optional portfolio metadata; no repo write by default) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/oauth/gitlab/callback
GITHUB_REDIRECT_URI=http://localhost:3000/api/oauth/github/callback

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=80
