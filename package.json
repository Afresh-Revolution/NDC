{
  "name": "ndc-naija",
  "version": "1.0.0",
  "private": true,
  "description": "Northside Developers Cooperative (NDC Naija) — member-owned technology cooperative platform",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:reset": "bun run src/db/migrate.ts && bun run src/db/seed.ts",
    "setup": "bun run db:migrate && bun run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hookform/resolvers": "^5.2.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.6",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "otpauth": "^9.4.1",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "recharts": "^3.2.1",
    "resend": "^6.1.2",
    "sass": "^1.93.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
